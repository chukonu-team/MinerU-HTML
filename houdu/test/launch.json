{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            // "args": ["--name", "zhangsan", "--age", "20", "./test.txt"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "GPU_IDS": "0",  // 必配！把项目根目录加入Python搜索路径
                "VRAM_SIZE_GB": "32",
                "WORKERS_PER_GPU": "1",
                "GPU_MEMORY_UTILIZATION": "0.5",
                "PROPORTION": "0.03",
                "TORCHDYNAMO_VERBOSE": "1",
                "OMP_NUM_THREADS": "3",
                "MKL_NUM_THREADS": "3",
                // "LD_LIBRARY_PATH": "/usr/local/cuda-11.8/targets/x86_64-linux/lib/stubs:$LD_LIBRARY_PATH",
                "OPENBLAS_NUM_THREADS": "3"
            }

        }
    ]
}